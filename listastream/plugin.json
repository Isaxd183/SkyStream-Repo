{
  "packageName": "com.isaxd183.listastream",
  "name": "ListaStream",
  "version": 1,
  "versionName": "1.0.0",
  "description": "Gestiona y reproduce tus listas M3U e IPTV",
  "baseUrl": "listastream://local",
  "categories": ["LiveTV", "Movies", "Series"],
  "iconUrl": "",
  "authors": ["Isaxd183"],
  "languages": ["es", "en", "all"],
  "preferences": [
    {
      "key": "cat_add",
      "type": "PreferenceCategory",
      "title": "Añadir lista M3U"
    },
    {
      "key": "pref_add_name",
      "type": "EditText",
      "title": "Nombre de la lista",
      "summary": "Nombre para identificar la lista",
      "hint": "Mi Lista IPTV",
      "defaultValue": ""
    },
    {
      "key": "pref_add_url",
      "type": "EditText",
      "title": "Enlace M3U",
      "summary": "URL directa del archivo .m3u o .m3u8",
      "hint": "https://mi-proveedor.com/lista.m3u",
      "defaultValue": ""
    },
    {
      "key": "action_add_playlist",
      "type": "Button",
      "title": "Añadir lista",
      "summary": "Guarda la lista con el nombre y enlace indicados",
      "action": "addPlaylist"
    },
    {
      "key": "cat_saved",
      "type": "PreferenceCategory",
      "title": "Mis listas guardadas"
    },
    {
      "key": "saved_playlists_display",
      "type": "PlaylistManager",
      "title": "Listas guardadas",
      "summary": "Pulsa Editar o Eliminar en cada lista",
      "dataKey": "m3u_playlists",
      "editAction": "editPlaylist",
      "deleteAction": "deletePlaylist"
    }
  ]
}
